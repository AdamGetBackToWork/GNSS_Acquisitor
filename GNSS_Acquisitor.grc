- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Blocks:\n\nEach time this file is saved,\
      \ GRC will instantiate the first class it finds\nto get ports and parameters\
      \ of your block. The arguments to __init__  will\nbe the parameters. All of\
      \ them are required to have default values!\n\"\"\"\n\nimport numpy as np\n\
      from gnuradio import gr\nimport scipy.fft as _fft\n\n#  Constants\nCA_RATE =\
      \ 1.023e6\nCA_LEN = 1023\n\n# G2 phase selector taps (1-based stages) for PRN\
      \ 1..32\nG2_TAPS = {\n    1: (2, 6), 2: (3, 7), 3: (4, 8), 4: (5, 9), 5: (1,\
      \ 9), 6: (2, 10),\n    7: (1, 8), 8: (2, 9), 9: (3, 10), 10: (2, 3), 11: (3,\
      \ 4), 12: (5, 6),\n    13: (6, 7), 14: (7, 8), 15: (8, 9), 16: (9, 10), 17:\
      \ (1, 4), 18: (2, 5),\n    19: (3, 6), 20: (4, 7), 21: (5, 8), 22: (6, 9), 23:\
      \ (1, 3), 24: (4, 6),\n    25: (5, 7), 26: (6, 8), 27: (7, 9), 28: (8, 10),\
      \ 29: (1, 6), 30: (2, 7),\n    31: (3, 8), 32: (4, 9),\n}\n\n# Initial parameter\
      \ values - to be overwritten by grc simulation parameters\nSAMPLING_FREQ = 25e6\n\
      DOPPLER_STEP  = 500.0\nDOPPLER_MAX   = 5000.0\nCODE_STEP     = 1\nSKIP_MS  \
      \     = 0\n\n\n\n\n# --------------------------------------------------------------------------\n\
      # Acquisition DSP\n# --------------------------------------------------------------------------\n\
      \n# # Generate CA Codes of GPS\n# def ca_code():\n\n# # Resample the CA code\
      \ to the specific f_s\n# def resample_code():\n\n# # \n# def acquire_prn():\
      \  \n\n# # \n# def acquire_iq_samples():\n\n\nclass blk(gr.sync_block):\n  \
      \  \"\"\"Embedded Python Block example - a simple multiply const\"\"\"\n\n \
      \   def __init__(self, sampling_freq = SAMPLING_FREQ, doppler_step = DOPPLER_STEP,\
      \ \n                doppler_max = DOPPLER_MAX, code_step = CODE_STEP, skip_ms\
      \ = SKIP_MS, \n                ): \n        \"\"\"arguments to this function\
      \ show up as parameters in GRC\"\"\"\n        gr.sync_block.__init__(\n    \
      \        self,\n            name='GPS Acquisitor',\n            in_sig=[np.complex64],\n\
      \            out_sig=[np.complex64]\n        )\n\n        self.sampling_freq\
      \ = sampling_freq\n        self.doppler_step  = doppler_step\n        self.doppler_max\
      \   = doppler_max\n        self.code_step     = code_step\n        self.skip_ms\
      \       = skip_ms\n\n\n    def work(self, input_items, output_items):\n    \
      \    \"\"\"example: multiply with constant\"\"\"\n        output_items[0][:]\
      \ = input_items[0] * self.example_param\n        return len(output_items[0])\n"
    affinity: ''
    alias: ''
    code_step: code_step
    comment: ''
    doppler_max: dopp_max
    doppler_step: dopp_step
    maxoutbuf: '0'
    minoutbuf: '0'
    sampling_freq: samp_rate
    skip_ms: '0'
  states:
    _io_cache: ('GPS Acquisitor', 'blk', [('sampling_freq', '25000000.0'), ('doppler_step',
      '500.0'), ('doppler_max', '5000.0'), ('code_step', '1'), ('skip_ms', '0')],
      [('0', 'complex', 1)], [('0', 'complex', 1)], 'Embedded Python Block example
      - a simple multiply const', ['code_step', 'doppler_max', 'doppler_step', 'sampling_freq',
      'skip_ms'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [696, 208.0]
    rotation: 0
    state: enabled
- name: epy_block_1_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Blocks:\n\nEach time this file is saved,\
      \ GRC will instantiate the first class it finds\nto get ports and parameters\
      \ of your block. The arguments to __init__  will\nbe the parameters. All of\
      \ them are required to have default values!\n\"\"\"\n\nimport numpy as np\n\
      from gnuradio import gr\nimport scipy.fft as _fft\n\n#  Constants\nCA_RATE =\
      \ 1.023e6\nCA_LEN = 1023\n\n# G2 phase selector taps (1-based stages) for PRN\
      \ 1..32\nG2_TAPS = {\n    1: (2, 6), 2: (3, 7), 3: (4, 8), 4: (5, 9), 5: (1,\
      \ 9), 6: (2, 10),\n    7: (1, 8), 8: (2, 9), 9: (3, 10), 10: (2, 3), 11: (3,\
      \ 4), 12: (5, 6),\n    13: (6, 7), 14: (7, 8), 15: (8, 9), 16: (9, 10), 17:\
      \ (1, 4), 18: (2, 5),\n    19: (3, 6), 20: (4, 7), 21: (5, 8), 22: (6, 9), 23:\
      \ (1, 3), 24: (4, 6),\n    25: (5, 7), 26: (6, 8), 27: (7, 9), 28: (8, 10),\
      \ 29: (1, 6), 30: (2, 7),\n    31: (3, 8), 32: (4, 9),\n}\n\n# Initial parameter\
      \ values - to be overwritten by grc simulation parameters\nSAMPLING_FREQ = 25e6\n\
      DOPPLER_STEP  = 500.0\nDOPPLER_MAX   = 5000.0\nCODE_STEP     = 1\nSKIP_MS  \
      \     = 0\n\n\n\n\n# --------------------------------------------------------------------------\n\
      # Acquisition DSP\n# --------------------------------------------------------------------------\n\
      \n# # Generate CA Codes of GPS\n# def ca_code():\n\n# # Resample the CA code\
      \ to the specific f_s\n# def resample_code():\n\n# # \n# def acquire_prn():\
      \  \n\n# # \n# def acquire_iq_samples():\n\n\nclass blk(gr.sync_block):\n  \
      \  \"\"\"Embedded Python Block example - a simple multiply const\"\"\"\n\n \
      \   def __init__(self, sampling_freq = SAMPLING_FREQ, doppler_step = DOPPLER_STEP,\
      \ \n                doppler_max = DOPPLER_MAX, code_step = CODE_STEP, skip_ms\
      \ = SKIP_MS, \n                ): \n        \"\"\"arguments to this function\
      \ show up as parameters in GRC\"\"\"\n        gr.sync_block.__init__(\n    \
      \        self,\n            name='Galileo Acquisitor',\n            in_sig=[np.complex64],\n\
      \            out_sig=[np.complex64]\n        )\n\n        self.sampling_freq\
      \ = sampling_freq\n        self.doppler_step  = doppler_step\n        self.doppler_max\
      \   = doppler_max\n        self.code_step     = code_step\n        self.skip_ms\
      \       = skip_ms\n\n\n    def work(self, input_items, output_items):\n    \
      \    \"\"\"example: multiply with constant\"\"\"\n        output_items[0][:]\
      \ = input_items[0] * self.example_param\n        return len(output_items[0])\n"
    affinity: ''
    alias: ''
    code_step: code_step
    comment: ''
    doppler_max: dopp_max
    doppler_step: dopp_step
    maxoutbuf: '0'
    minoutbuf: '0'
    sampling_freq: samp_rate
    skip_ms: '0'
  states:
    _io_cache: ('Galileo Acquisitor', 'blk', [('sampling_freq', '25000000.0'), ('doppler_step',
      '500.0'), ('doppler_max', '5000.0'), ('code_step', '1'), ('skip_ms', '0')],
      [('0', 'complex', 1)], [('0', 'complex', 1)], 'Embedded Python Block example
      - a simple multiply const', ['code_step', 'doppler_max', 'doppler_step', 'sampling_freq',
      'skip_ms'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [696, 320.0]
    rotation: 0
    state: enabled

